# Скопировать в .env при необходимости переопределить дефолты (config.go).
# В проде (ALLOWED_ORIGINS задан) сервер не стартует на dev-секретах LiveKit/S3
# и без SECURE_COOKIES=true (config.ValidateProd, fail-fast).
PORT=8080
DATABASE_URL=postgres://pms_app:pms_app@localhost:5432/pms?sslmode=disable
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pms?sslmode=disable
JOBS_DATABASE_URL=postgres://pms_jobs:pms_jobs@localhost:5432/pms?sslmode=disable
REDIS_URL=redis://localhost:6379/0
SESSION_TTL=720h
# Прод-секьюрити (пусто → dev: любой origin, cookie без Secure).
# Задать в проде: строгий CORS-allowlist (CSV) + origin-check CSRF + Secure-cookie за TLS.
# ALLOWED_ORIGINS=https://stdtask.com
# SECURE_COOKIES=true
# LiveKit SFU (митинги). Dev-дефолты совпадают с docker/livekit.yaml. В проде заменить ключи + URL за TLS (wss://).
# LIVEKIT_URL=wss://livekit.example.com
# LIVEKIT_API_URL=https://livekit.example.com   # http(s) для server-API (reaper)
# LIVEKIT_API_KEY=prodkey
# LIVEKIT_SECRET=<32+ char secret>
# MEETING_REAP_EVERY=1m   # как часто гасить мёртвые live-митинги (нет комнаты в LiveKit)
# Async (River) + почта (пусто → письма в лог, не отправляются)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# SMTP_FROM=stdtask <no-reply@stdtask.com>
# DUE_SOON_INTERVAL=1h
# WEBHOOK_DISPATCH_EVERY=10s   # как часто диспетчер сканит change_log и шлёт вебхуки
# EMAIL_SWEEP_EVERY=2m
# SNAPSHOT_EVERY=24h

# PUSH_DISPATCH_EVERY=15s   # Expo push (mobile)

# S3 (Garage self-hosted, S3-совместимо). Dev-дефолты совпадают с docker/garage; в проде заменить ключи.
# S3_ENDPOINT=http://localhost:3900
# S3_PUBLIC_BASE=http://localhost:3900   # база presigned-ссылок для браузера
# S3_REGION=garage
# S3_BUCKET=pms
# S3_ACCESS_KEY=...
# S3_SECRET=...

# AI embed-сайдкар (fastembed). Semantic search / suggestions / clustering.
EMBED_URL=http://127.0.0.1:8100
# EMBED_SWEEP_EVERY=10s     # воркер эмбеддингов
# MODEL_TRAIN_EVERY=30m     # переобучение per-ws моделей (priority/estimate/slip)
# CLUSTER_EVERY=30m         # топик-кластеры (Themes)

# Recurring issue-шаблоны
# RECURRING_EVERY=1h        # dev: 30s
